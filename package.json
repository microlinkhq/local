{
  "name": "@microlink/local",
  "description": "Run Microlink Functions locally with Puppeteer/Playwright for faster development loops.",
  "homepage": "https://github.com/microlinkhq/local",
  "version": "1.0.8",
  "bin": {
    "microlink-local": "src/index.js"
  },
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://github.com/Kikobeats"
  },
  "repository": {
    "directory": "packages/local",
    "type": "git",
    "url": "git+https://github.com/microlinkhq/local.git"
  },
  "bugs": {
    "url": "https://github.com/microlinkhq/local/issues"
  },
  "keywords": [
    "browserless",
    "chrome",
    "debug",
    "devtools",
    "function",
    "local",
    "microlink",
    "playwright",
    "puppeteer",
    "serverless"
  ],
  "dependencies": {
    "@browserless/function": "~9.5.2",
    "@microlink/cli": "~2.1.0",
    "browserless": "~9.5.1",
    "picocolors": "~1.0.0",
    "pretty-ms": "~7.0.1",
    "puppeteer": "~15.3.2",
    "update-notifier": "5"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@mozilla/readability": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "git-dirty": "latest",
    "github-generate-release": "latest",
    "nano-staged": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">= 12"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "contributors": "(npx git-authors-cli && npx finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "lint": "standard-markdown README.md && standard",
    "postrelease": "npm run release:tags && npm run release:github && npm publish --access=public",
    "prerelease": "git-dirty && npm run update:check && npm test && npm run contributors",
    "pretest": "npm run lint",
    "release": "git-authors-cli finepack && git add package.json && standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin master",
    "test": "exit 0"
  },
  "preferGlobal": true,
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "npx @kikobeats/prettier-standard",
      "standard --fix"
    ],
    "*.md": [
      "standard-markdown"
    ],
    "package.json": [
      "finepack"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  }
}
